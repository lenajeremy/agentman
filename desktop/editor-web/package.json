{
  "name": "agentman-editor-web",
  "private": true,
  "version": "0.0.0",
  "description": "The editor inside Agentman for Mac: Monaco, themed for the app, in a WKWebView.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/convert.test.ts --bundle --platform=node --format=esm --outfile=.test/convert.test.mjs --log-level=warning && node --test .test/convert.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "monaco-editor": "0.57.0",
    "typescript": "5.9.3"
  }
}
