{
  "name": "agentman-editor-web",
  "private": true,
  "version": "0.0.0",
  "description": "The editor inside Agentman for Mac: Monaco, themed for the app, in a WKWebView.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/convert.test.ts test/roles.test.ts test/gitdiff.test.ts --bundle --platform=node --format=esm --outdir=.test --splitting --log-level=warning && node --test .test/convert.test.js .test/roles.test.js .test/gitdiff.test.js"
  },
  "devDependencies": {
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-javascript": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/vscode-textmate": "10.1.0",
    "esbuild": "0.28.2",
    "monaco-editor": "0.57.0",
    "monaco-vim": "0.4.4",
    "typescript": "5.9.3"
  }
}
