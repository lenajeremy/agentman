<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="agentman"
        Arguments=""
        InstallLocation="C:\Program Files\Agentman\Agentman">
    </Installer>
    <PackageInformation
        PackageName="Agentman"
        PackageDisplayName="Agentman"
        PublisherName="CN=Agentman"
        PublisherDisplayName="Agentman"
        Version="0.1.0.0"
        PackageDescription="Every coding agent on this computer, in one window">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.agentman.app"
                Description="Every coding agent on this computer, in one window"
                DisplayName="Agentman"
                ExecutableName="agentman"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Agentman</DisplayName>
            <PublisherDisplayName>Agentman</PublisherDisplayName>
            <Description>Every coding agent on this computer, in one window</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="agentman.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
