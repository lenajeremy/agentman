{
  "expo": {
    "name": "agentman",
    "slug": "agentman",
    "version": "0.15.0",
    "orientation": "portrait",
    "scheme": "agentman",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.agentman.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Allow Agentman to save an image from your Mac to your photo library."
      },
      "buildNumber": "42",
      "appleTeamId": "N58PT393QS"
    },
    "android": {
      "package": "dev.agentman.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F1012"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Agentman to scan a one-time pairing QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Agentman to attach a screenshot or photo to a message for your agent."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/agentman-needs-you.wav",
            "./assets/sounds/agentman-finished.wav"
          ]
        }
      ],
      "./plugins/withIosBuildFixes",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "Agentman listens while you record with the mic button, so you can speak a message to an agent or to Agentman instead of typing it. Your Mac has Celery write it out."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5526986e-22be-46f7-8e5e-a4a0a2307197"
      }
    },
    "owner": "jeremiahlena13",
    "icon": "./assets/images/icon.png",
    "web": {
      "favicon": "./assets/images/favicon.png"
    }
  }
}
