{
  "expo": {
    "name": "agentman",
    "slug": "agentman",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "agentman",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.agentman.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.agentman.mobile",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Agentman to scan a one-time pairing QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      "./plugins/withIosBuildFixes"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5526986e-22be-46f7-8e5e-a4a0a2307197"
      }
    },
    "owner": "jeremiahlena13"
  }
}
