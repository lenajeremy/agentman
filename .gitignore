# Binaries. These are anchored with a leading slash on purpose: a bare `am`
# also matches the cmd/am/ directory and would silently exclude the CLI source.
/bin/
/dist/
/am
/relay
*.exe

# Go
*.test
*.out
vendor/

# Mobile (Expo)
node_modules/
.expo/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Local
.env
.env.local
.DS_Store

# agentman local state (machine identifiers, pairing tokens — never commit)
.agentman/
dist/
