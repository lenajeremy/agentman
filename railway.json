{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "buildArgs": {
      "VERSION": "${{RAILWAY_GIT_COMMIT_SHA}}"
    },
    "watchPatterns": [
      "cmd/relay/**",
      "internal/relay/**",
      "internal/protocol/**",
      "Dockerfile",
      "go.mod",
      "go.sum",
      "railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
